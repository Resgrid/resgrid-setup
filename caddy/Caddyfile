# Resgrid reverse proxy. Hostnames and the TLS mode come from .env:
#   RESGRID_TLS=internal             certificates from Resgrid's local CA
#   RESGRID_TLS=you@example.com      Let's Encrypt
#   RESGRID_TLS=/certs/site/fullchain.pem /certs/site/privkey.pem
#                                    your own certificate files
# Plain HTTP requests are redirected to HTTPS.

{
	http_port {$RESGRID_HTTP_PORT:80}
	https_port {$RESGRID_HTTPS_PORT:443}

	# The local CA is generated by setup.sh (certs/ca/resgrid-root-ca.crt) so
	# its certificate can be handed to clients and containers up front.
	skip_install_trust
	pki {
		ca local {
			name "Resgrid Local CA"
			root {
				cert /certs/ca/resgrid-root-ca.crt
				key /certs/private/resgrid-root-ca.key
			}
		}
	}
}

(resgrid_proxy) {
	reverse_proxy {args[0]} {
		header_up X-Real-IP {remote_host}
	}
}

{$RESGRID_WEB_HOST} {
	tls {$RESGRID_TLS}
	encode zstd gzip

	# Offline map tiles from the optional tileserver (profile "maps").
	handle_path /tiles/* {
		rewrite * /tile{uri}
		reverse_proxy tileserver:80 {
			# Resgrid's login cookies are larger than the tile server
			# (Apache) accepts; tiles don't need them.
			header_up -Cookie
			header_up -Authorization
		}
	}

	handle {
		import resgrid_proxy web:8080
	}
}

{$RESGRID_API_HOST} {
	tls {$RESGRID_TLS}
	encode zstd gzip

	# Dispatch audio playback (fetched by Twilio) is served by the TTS service.
	handle /tts/audio/* {
		reverse_proxy tts:8080
	}

	handle {
		import resgrid_proxy api:8080
	}
}

{$RESGRID_EVENTS_HOST} {
	tls {$RESGRID_TLS}
	import resgrid_proxy events:8080
}
