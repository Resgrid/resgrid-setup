# RICK reverse proxy (edge node). Every client connects here; Caddy forwards
# to the web app and events hub on this node and to the API, TTS and map
# tiles on the app and infra nodes. Hostnames, node addresses and the TLS
# mode come from .env:
#   RESGRID_TLS=internal             certificates from Resgrid's local CA
#   RESGRID_TLS=/certs/site/fullchain.pem /certs/site/privkey.pem
#                                    your own (publicly trusted) certificate
# Plain HTTP requests are redirected to HTTPS.

{
	http_port {$RESGRID_HTTP_PORT:80}
	https_port {$RESGRID_HTTPS_PORT:443}

	# The local CA is generated by setup.sh (certs/ca/resgrid-root-ca.crt) so
	# its certificate can be handed to clients and containers up front.
	skip_install_trust
	pki {
		ca local {
			name "Resgrid Local CA"
			root {
				cert /certs/ca/resgrid-root-ca.crt
				key /certs/private/resgrid-root-ca.key
			}
		}
	}
}

(resgrid_proxy) {
	reverse_proxy {args[0]} {
		header_up X-Real-IP {remote_host}
	}
}

{$RESGRID_WEB_HOST} {
	tls {$RESGRID_TLS}
	encode zstd gzip

	# Offline map tiles from the tile server on the infra node.
	handle_path /tiles/* {
		rewrite * /tile{uri}
		reverse_proxy {$RICK_INFRA_HOST}:5156 {
			# Resgrid's login cookies are larger than the tile server
			# (Apache) accepts; tiles don't need them.
			header_up -Cookie
			header_up -Authorization
		}
	}

	handle {
		import resgrid_proxy 127.0.0.1:5151
	}
}

{$RESGRID_API_HOST} {
	tls {$RESGRID_TLS}
	encode zstd gzip

	# Dispatch audio playback is served by the TTS service on the app node.
	handle /tts/audio/* {
		reverse_proxy {$RICK_APP_HOST}:5154
	}

	handle {
		import resgrid_proxy {$RICK_APP_HOST}:5152
	}
}

{$RESGRID_EVENTS_HOST} {
	tls {$RESGRID_TLS}
	import resgrid_proxy 127.0.0.1:5153
}
