# ===================================================================
# AMBIPAR RESPONSE CANADA - EXAMPLE CONFIGURATION
# ===================================================================
# Copy this file to .env.ambipar and update with your actual values
# DO NOT commit .env.ambipar with real credentials to version control!
# ===================================================================

# -----------------------------------------------
# --- AI Provider Configuration -----------------
# -----------------------------------------------

# AI Provider Selection (OpenAI, Azure, Anthropic)
AMBIPAR__AIProviderType=OpenAI

# OpenAI Configuration
AMBIPAR__OpenAIApiKey=sk-proj-REPLACE_WITH_YOUR_OPENAI_KEY
AMBIPAR__OpenAIOrganizationId=org-REPLACE_WITH_YOUR_ORG_ID
AMBIPAR__OpenAIModel=gpt-4-turbo
AMBIPAR__OpenAIMaxTokens=2000

# Azure OpenAI Configuration (Alternative)
AMBIPAR__AzureOpenAIEndpoint=https://your-resource.openai.azure.com/
AMBIPAR__AzureOpenAIKey=REPLACE_WITH_YOUR_AZURE_KEY
AMBIPAR__AzureOpenAIDeployment=gpt-4-turbo
AMBIPAR__AzureOpenAIApiVersion=2024-02-15-preview

# Anthropic Claude Configuration (Alternative)
AMBIPAR__AnthropicApiKey=sk-ant-REPLACE_WITH_YOUR_ANTHROPIC_KEY
AMBIPAR__AnthropicModel=claude-3-5-sonnet-20241022
AMBIPAR__AnthropicMaxTokens=4000

# -----------------------------------------------
# --- SharePoint Integration --------------------
# -----------------------------------------------

AMBIPAR__SharePointSiteUrl=https://yourcompany.sharepoint.com/sites/resgrid
AMBIPAR__SharePointClientId=REPLACE_WITH_CLIENT_ID
AMBIPAR__SharePointClientSecret=REPLACE_WITH_CLIENT_SECRET
AMBIPAR__SharePointTenantId=REPLACE_WITH_TENANT_ID
AMBIPAR__SharePointDocumentLibrary=Resgrid Documents
AMBIPAR__SharePointEnabled=false

# -----------------------------------------------
# --- Microsoft 365 Integration -----------------
# -----------------------------------------------

AMBIPAR__M365TenantId=REPLACE_WITH_TENANT_ID
AMBIPAR__M365ClientId=REPLACE_WITH_CLIENT_ID
AMBIPAR__M365ClientSecret=REPLACE_WITH_CLIENT_SECRET
AMBIPAR__M365Enabled=false

# -----------------------------------------------
# --- Geotab Fleet Tracking Integration ---------
# -----------------------------------------------

AMBIPAR__GeotabServerUrl=https://my.geotab.com
AMBIPAR__GeotabDatabase=your-database-name
AMBIPAR__GeotabUsername=REPLACE_WITH_USERNAME
AMBIPAR__GeotabPassword=REPLACE_WITH_PASSWORD
AMBIPAR__GeotabEnabled=false

# -----------------------------------------------
# --- Replicon Timesheet Integration ------------
# -----------------------------------------------

AMBIPAR__RepliconApiUrl=https://na2.replicon.com/yourcompany/services
AMBIPAR__RepliconApiToken=REPLACE_WITH_API_TOKEN
AMBIPAR__RepliconCompanyKey=REPLACE_WITH_COMPANY_KEY
AMBIPAR__RepliconEnabled=false

# -----------------------------------------------
# --- Power Apps Integration --------------------
# -----------------------------------------------

AMBIPAR__PowerAppsEnvironmentId=REPLACE_WITH_ENVIRONMENT_ID
AMBIPAR__PowerAppsClientId=REPLACE_WITH_CLIENT_ID
AMBIPAR__PowerAppsClientSecret=REPLACE_WITH_CLIENT_SECRET
AMBIPAR__PowerAppsEnabled=false

# -----------------------------------------------
# --- AI Feature Flags --------------------------
# -----------------------------------------------

AMBIPAR__AI__EnableDispatchRecommendations=true
AMBIPAR__AI__EnableHazmatAnalysis=true
AMBIPAR__AI__EnableEquipmentPrediction=true
AMBIPAR__AI__EnableNaturalLanguageQueries=true
AMBIPAR__AI__EnableComplianceValidation=true

# -----------------------------------------------
# --- Compliance Settings -----------------------
# -----------------------------------------------

AMBIPAR__Compliance__EnableAutomatedChecks=true
AMBIPAR__Compliance__WarningDays=30
AMBIPAR__Compliance__SendAlerts=true
AMBIPAR__Compliance__AlertEmail=safety@yourcompany.com

# -----------------------------------------------
# --- Development Settings ----------------------
# -----------------------------------------------

AMBIPAR__Debug__EnableDebugMode=true
AMBIPAR__Debug__EnableDetailedErrors=true
AMBIPAR__Debug__EnableSwagger=true
