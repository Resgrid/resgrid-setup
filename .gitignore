# Installer marker
.setup-complete
deploy/generated/*
!deploy/generated/.gitkeep

# Runtime data
docker-data/sql/
docker-data/rustfs/
docker-data/redis/data/*
!docker-data/redis/data/.gitkeep
docker-data/caddy/data/*
!docker-data/caddy/data/.gitkeep
docker-data/caddy/config/*
!docker-data/caddy/config/.gitkeep
