# Configuration and secrets created by setup.sh (copy them to every node)
.env
.env.backup-*
.setup-complete

# Generated certificates and keys (keep the folders)
certs/ca/*
certs/site/*
certs/private/*
certs/acme/
!certs/**/.gitkeep

# Generated by setup.sh from .env
dns/dnsmasq.conf

# Backups and image bundles
backups/
bundle/

# Left by upgrades from older versions (setup copies the data, never deletes it)
.legacy-db-migrated
docker-data/
