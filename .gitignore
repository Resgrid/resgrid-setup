# Configuration and secrets created by setup.sh
.env
.env.backup-*
.setup-complete

# Generated certificates and keys (keep the folders)
certs/ca/*
certs/site/*
certs/private/*
!certs/**/.gitkeep

# Backups made with the commands in README.md
backups/

# Left by upgrades from older versions (setup copies the data, never deletes it)
.legacy-db-migrated
docker-data/
