# Files that are bind-mounted into Linux containers must keep LF endings,
# even when the repository is cloned on Windows.
*.sh text eol=lf
Caddyfile text eol=lf
enabled_plugins text eol=lf
*.conf text eol=lf
*.sql text eol=lf
.env* text eol=lf
*.env text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
