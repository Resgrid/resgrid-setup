# =============================================================================
#  Resgrid self-hosted configuration template
# =============================================================================
#
# Do not edit this file for a real install. Run ./setup.sh instead: it copies
# this template to .env, sets your hostnames, generates every password, key and
# certificate, and starts the stack. The values below are publicly known
# placeholders.
#
# .env is ignored by git, so `git pull` never overwrites your configuration.
# After pulling a new version run `./setup.sh upgrade` to add any settings
# that were introduced since you installed.
#
# Resgrid settings follow the pattern RESGRID__{ConfigClass}__{FieldName}
# (double underscores) and map to the static classes in Core/Resgrid.Config
# of https://github.com/Resgrid/Core. Names are case-sensitive, misspelled
# names are silently ignored, and enum values must be numbers.
# Reference: https://docs.resgrid.com/reference/docker

# -----------------------------------------------------------------------------
#  Hostnames and TLS (used by docker-compose.yml and the Caddyfile)
# -----------------------------------------------------------------------------

# Three hostnames, all resolving to this server. Browsers and mobile apps use
# all three, so every one must be reachable and trusted by clients.
RESGRID_WEB_HOST=rg.mylocal
RESGRID_API_HOST=rgapi.mylocal
RESGRID_EVENTS_HOST=rgevents.mylocal

# How Caddy obtains certificates:
#   internal                                  Resgrid's own local CA (certs/ca/resgrid-root-ca.crt).
#                                             For LAN/offline installs. Install the root CA on clients.
#   you@example.com                           Let's Encrypt. Needs public DNS and ports 80/443 open.
#   /certs/site/fullchain.pem /certs/site/privkey.pem
#                                             Your own certificate (copy the PEM files to certs/site/).
RESGRID_TLS=internal

# Ports Caddy publishes on this server. Keep 80/443 unless they are taken
# (e.g. by IIS). With another HTTPS port the public URLs below must include
# it (https://rg.mylocal:8443), and Let's Encrypt cannot be used.
RESGRID_HTTP_PORT=80
RESGRID_HTTPS_PORT=443

# -----------------------------------------------------------------------------
#  Optional features (managed by setup: `./setup.sh features`)
# -----------------------------------------------------------------------------
# Feature sections from features/catalog.ini that are switched on. Setup
# keeps this list, the feature flags in the database and the settings below
# in step; edit it through setup rather than by hand.
RESGRID_FEATURES=
# Sections setup has already asked about (re-runs only ask about new ones).
RESGRID_FEATURES_OFFERED=
# Extra Docker Compose profiles to run (maps, clamav, tracking, relay, ...).
# `docker compose up -d` reads this, so started add-ons stay started.
COMPOSE_PROFILES=

# -----------------------------------------------------------------------------
#  Infrastructure credentials
# -----------------------------------------------------------------------------
# Used by docker-compose.yml. The Resgrid connection strings further down
# repeat them; setup.sh keeps both in sync. Use letters and digits only.

POSTGRES_USER=resgrid
POSTGRES_PASSWORD=ChangeMePostgres1
REDIS_PASSWORD=ChangeMeRedis1
RABBITMQ_USER=resgrid
RABBITMQ_PASSWORD=ChangeMeRabbit1
# RustFS (S3-compatible object storage). Uppercase letters and digits only.
RUSTFS_ACCESS_KEY=CHANGEMERUSTFSACCESS
RUSTFS_SECRET_KEY=CHANGEMERUSTFSSECRETKEY0000000000000000

# -----------------------------------------------------------------------------
#  ASP.NET
# -----------------------------------------------------------------------------
# The Resgrid images run as a non-root user and listen on 8080.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Containers trust Resgrid's local CA (mounted from certs/ca) in addition to
# the public CAs, so server-to-server HTTPS calls through Caddy work with
# RESGRID_TLS=internal.
SSL_CERT_DIR=/etc/ssl/certs:/usr/local/share/resgrid-ca

# =============================================================================
#  Resgrid Core
# =============================================================================

# --- System behavior ---------------------------------------------------------

# Public URLs (https://<the hostnames above>). setup.sh sets them.
RESGRID__SystemBehaviorConfig__ResgridBaseUrl=https://rg.mylocal
RESGRID__SystemBehaviorConfig__ResgridApiBaseUrl=https://rgapi.mylocal
RESGRID__SystemBehaviorConfig__ResgridEventingBaseUrl=https://rgevents.mylocal

# 0 = Production, 1 = Staging, 2 = QA, 3 = Development
RESGRID__SystemBehaviorConfig__Environment=0

# Allow "Sign Up" (new account + department) without Resgrid's hosted billing
# service. Needed to create the first department on a self-hosted install;
# set to false afterwards to stop anyone else from creating departments.
RESGRID__SystemBehaviorConfig__AllowSignupWithoutBilling=true

# Error logging: 1 = Sentry.io (configure the Sentry section), 2 = Console
RESGRID__SystemBehaviorConfig__ErrorLoggerType=2

# Outbound email: 0 = Postmark, 1 = SMTP
RESGRID__SystemBehaviorConfig__OutboundEmailType=1

# Passphrases for signed links, call audio links and API tokens (generated).
RESGRID__SystemBehaviorConfig__ExternalLinkUrlParamPassphrase=ChangeMeLinkPassphrase
# The misspelling "Passhprase" is intentional; it matches the field in Core.
RESGRID__SystemBehaviorConfig__ExternalAudioUrlParamPasshprase=ChangeMeAudioPassphrase
RESGRID__SystemBehaviorConfig__ApiTokenEncryptionPassphrase=ChangeMeTokenPassphrase

# Key for the detailed /health/full endpoints (header X-Resgrid-Health-Key).
RESGRID__SystemBehaviorConfig__FullHealthCheckKey=

# --- Security ----------------------------------------------------------------

# Master encryption key, exactly 32 characters, and its salt (generated).
# Changing either after install makes encrypted data unreadable.
RESGRID__SecurityConfig__EncryptionKey=CHANGEME_32CHAR_MASTER_KEY_HERE!
RESGRID__SecurityConfig__EncryptionSaltValue=CHANGEME_SALT_VALUE_HERE

# Server-to-server key (header X-Resgrid-SystemApiKey), used by the email
# relay. Empty disables the scheme.
RESGRID__SecurityConfig__SystemApiKey=

# Pepper for department API keys (generated). Empty derives it from the
# encryption key.
RESGRID__SecurityConfig__DepartmentApiKeyPepper=

# Reject unsigned legacy file links (new installs have none).
RESGRID__SecurityConfig__AllowLegacySignedFileLinks=false

# Encrypt authenticator (TOTP) seeds at rest.
RESGRID__TwoFactorConfig__AuthenticatorSeedEncryptionEnabled=true

# --- API ---------------------------------------------------------------------

# Shared secret the web app uses to obtain API tokens server-side (web BFF:
# chat, messages, maps, push devices, the events token). REQUIRED (generated).
RESGRID__ApiConfig__BackendInternalApikey=

# Must stay false. Core refuses to start with true in Production; the
# containers trust the local CA instead (see SSL_CERT_DIR above).
RESGRID__ApiConfig__BypassSslChecks=false

# --- Cache -------------------------------------------------------------------

RESGRID__CacheConfig__RedisConnectionString=redis:6379,password=ChangeMeRedis1,allowAdmin=True

# --- Databases ---------------------------------------------------------------
# 0 = SQL Server, 1 = PostgreSQL. This stack uses PostgreSQL for everything,
# including the document database (no MongoDB).

RESGRID__DataConfig__DatabaseType=1
RESGRID__DataConfig__ConnectionString=User ID=resgrid;Password=ChangeMePostgres1;Host=db;Port=5432;Database=resgrid;Pooling=true;Connection Lifetime=0;Include Error Detail=true;
# Must equal ConnectionString. Used by the repositories and the migration runner.
RESGRID__DataConfig__CoreConnectionString=User ID=resgrid;Password=ChangeMePostgres1;Host=db;Port=5432;Database=resgrid;Pooling=true;Connection Lifetime=0;Include Error Detail=true;
RESGRID__DataConfig__DocDatabaseType=1
RESGRID__DataConfig__DocumentConnectionString=User ID=resgrid;Password=ChangeMePostgres1;Host=db;Port=5432;Database=resgriddoc;Pooling=true;Connection Lifetime=0;Include Error Detail=true;

RESGRID__OidcConfig__DatabaseType=1
RESGRID__OidcConfig__ConnectionString=User ID=resgrid;Password=ChangeMePostgres1;Host=db;Port=5432;Database=resgridoidc;Pooling=true;Connection Lifetime=0;Include Error Detail=true;

RESGRID__WorkerConfig__DatabaseType=1
RESGRID__WorkerConfig__WorkerDbConnectionString=User ID=resgrid;Password=ChangeMePostgres1;Host=db;Port=5432;Database=resgridworkers;Pooling=true;Connection Lifetime=0;Include Error Detail=true;

# The worker creates and upgrades the database schema at startup. Must be the
# literal string true.
RESGRID__DODBUPGRADE=true

# --- OpenID Connect (token server inside the API) ----------------------------
# Base64 PKCS#12 certificates with an EMPTY password (generated by setup.sh).
# Replacing them signs every user out.
RESGRID__OidcConfig__EncryptionCert=
RESGRID__OidcConfig__SigningCert=

# --- JWT ---------------------------------------------------------------------
# Shared by the API and events containers (generated).
RESGRID__JwtConfig__EventsClientSecret=ChangeMeEventsClientSecret

# --- Service bus (RabbitMQ) --------------------------------------------------

RESGRID__ServiceBusConfig__RabbitHostname=rabbitmq
RESGRID__ServiceBusConfig__RabbitHostname2=
RESGRID__ServiceBusConfig__RabbitHostname3=
RESGRID__ServiceBusConfig__RabbitUsername=resgrid
# The triple "b" in Rabbbit is intentional; it matches the field in Core.
RESGRID__ServiceBusConfig__RabbbitPassword=ChangeMeRabbit1

# --- Worker ------------------------------------------------------------------
# AES key for background job payloads (generated).
RESGRID__WorkerConfig__PayloadKey=ChangeMePayloadKey

# --- Web ---------------------------------------------------------------------
# Network the reverse proxy (Caddy) connects from; forwarded headers are only
# trusted from here. Matches the rgmain network in docker-compose.yml.
RESGRID__WebConfig__IngressProxyNetwork=172.16.193.0
RESGRID__WebConfig__IngressProxyNetworkCidr=24

# Google reCAPTCHA for the Sign Up, Forgot Password and invite pages.
# https://www.google.com/recaptcha/admin  (needs internet on the client and server)
RESGRID__WebConfig__RecaptchaPublicKey=
RESGRID__WebConfig__RecaptchaPrivateKey=

# --- Maps and geocoding ------------------------------------------------------
# Raster tile server for the web map. The public OpenStreetMap servers are for
# initial testing only: https://operations.osmfoundation.org/policies/tiles/
# With the offline tile server (profile "maps") use
#   https://<web host>/tiles/{z}/{x}/{y}.png
RESGRID__MappingConfig__LeafletTileUrl=https://tile.openstreetmap.org/{z}/{x}/{y}.png
RESGRID__MappingConfig__LeafletAttribution=© OpenStreetMap contributors
# Address search and routing used by the web map (public OSM services by default).
RESGRID__MappingConfig__NominatimUrl=https://nominatim.openstreetmap.org
RESGRID__MappingConfig__OsrmUrl=https://router.project-osrm.org
# Optional commercial providers.
RESGRID__MappingConfig__GoogleMapsJSKey=
RESGRID__MappingConfig__GoogleMapsApiKey=
RESGRID__MappingConfig__What3WordsApiKey=
# The Responder and Unit mobile apps draw maps with Mapbox only.
RESGRID__MappingConfig__ResponderAppMapboxKey=
RESGRID__MappingConfig__UnitAppMapBoxKey=

# --- Object storage (RustFS) -------------------------------------------------
# Buckets are created by the rustfs-init one-shot container.

# Text-to-speech audio. S3UsePresignedUrls=false keeps RustFS internal: the
# TTS service proxies audio itself.
RESGRID__TtsConfig__ServiceBaseUrl=http://tts:8080
# Base URL Twilio fetches call audio from. Caddy routes /tts/audio/* on the
# API hostname to the TTS container.
RESGRID__TtsConfig__PlaybackBaseUrl=https://rgapi.mylocal
# Admin key for the static prompt endpoint (generated, required).
RESGRID__TtsConfig__StaticPromptAdminKey=ChangeMeTtsAdminKey1
RESGRID__TtsConfig__S3Endpoint=http://rustfs:9000
RESGRID__TtsConfig__S3AccessKey=CHANGEMERUSTFSACCESS
RESGRID__TtsConfig__S3SecretKey=CHANGEMERUSTFSSECRETKEY0000000000000000
RESGRID__TtsConfig__S3Bucket=resgrid-tts
RESGRID__TtsConfig__S3UseSsl=false
RESGRID__TtsConfig__S3ForcePathStyle=true
RESGRID__TtsConfig__S3UsePresignedUrls=false

# Department Import (spreadsheets, CAD/RMS exports).
RESGRID__ImportConfig__S3Endpoint=http://rustfs:9000
RESGRID__ImportConfig__S3AccessKey=CHANGEMERUSTFSACCESS
RESGRID__ImportConfig__S3SecretKey=CHANGEMERUSTFSSECRETKEY0000000000000000
RESGRID__ImportConfig__S3Bucket=resgrid-imports
RESGRID__ImportConfig__S3UseSsl=false
RESGRID__ImportConfig__S3ForcePathStyle=true

# Built-in search index (feature "search"). The index is kept in the object
# store; each container keeps a local copy in /data/search.
RESGRID__SearchConfig__Enabled=false
RESGRID__SearchConfig__IndexPath=/data/search
RESGRID__SearchConfig__S3Endpoint=
RESGRID__SearchConfig__S3AccessKey=
RESGRID__SearchConfig__S3SecretKey=
RESGRID__SearchConfig__S3Bucket=resgrid-search
RESGRID__SearchConfig__S3UseSsl=false
RESGRID__SearchConfig__S3ForcePathStyle=true

# Virus scanning of uploaded files with ClamAV (feature "scanning").
RESGRID__AttachmentScanningConfig__Enabled=false
RESGRID__AttachmentScanningConfig__Host=clamav
RESGRID__AttachmentScanningConfig__Port=3310

# --- Outbound email ----------------------------------------------------------
# Invites, password resets and notifications. No mail server is included:
# point these at your SMTP server or relay, or use Postmark (type 0).
RESGRID__OutboundEmailServerConfig__FromMail=resgrid@yourcompany.local
RESGRID__OutboundEmailServerConfig__Host=
RESGRID__OutboundEmailServerConfig__Port=587
RESGRID__OutboundEmailServerConfig__EnableSsl=true
RESGRID__OutboundEmailServerConfig__UserName=
RESGRID__OutboundEmailServerConfig__Password=
RESGRID__OutboundEmailServerConfig__PostmarkApiKey=

# --- Error reporting (Sentry.io) ---------------------------------------------
RESGRID__ExternalErrorConfig__Environment=selfhosted
RESGRID__ExternalErrorConfig__ExternalErrorServiceUrlForApi=
RESGRID__ExternalErrorConfig__ExternalErrorServiceUrlForWebsite=
RESGRID__ExternalErrorConfig__ExternalErrorServiceUrlForWebjobs=
RESGRID__ExternalErrorConfig__ExternalErrorServiceUrlForEventing=

# --- MCP server (AI assistants) ----------------------------------------------
# The MCP HTTP endpoint is UNAUTHENTICATED (users log in inside the protocol).
# Keep host port 5155 on your LAN/VPN only.
RESGRID__McpConfig__CorsAllowedOrigins=*

# --- GPS tracker gateway (profile "tracking") --------------------------------
# Hardware trackers connect to raw TCP/UDP ports: Queclink 5004, GT06 5023,
# Teltonika 5027. To enable set Enabled, NativeGatewayEnabled and at least one
# protocol to true, then: docker compose --profile tracking up -d
RESGRID__UnitTrackingConfig__Enabled=false
RESGRID__UnitTrackingConfig__NativeGatewayEnabled=false
# Pepper for tracker device credentials (generated). Changing it later
# invalidates enrolled devices.
RESGRID__UnitTrackingConfig__CredentialPepper=ChangeMeTrackerPepper
RESGRID__UnitTrackingConfig__EnableQueclink=false
RESGRID__UnitTrackingConfig__EnableGt06=false
RESGRID__UnitTrackingConfig__EnableTeltonika=false

# --- Inbound email dispatch relay (profile "relay") --------------------------
# SMTP listener that turns email into dispatches. It accepts any sender (no
# TLS, no SMTP auth); the recipient domain list is the only gate. Firewall
# port 25 to your upstream mail server. Uses the RESGRID__RELAY__ prefix
# (https://github.com/Resgrid/Relay); Core ignores these.
RESGRID__RELAY__Mode=smtp
RESGRID__RELAY__Resgrid__BaseUrl=http://api:8080
# SystemApiKey auth; the key must equal RESGRID__SecurityConfig__SystemApiKey.
RESGRID__RELAY__Resgrid__GrantType=SystemApiKey
RESGRID__RELAY__Resgrid__SystemApiKey=
# Validated as non-empty at startup but unused with SystemApiKey auth.
RESGRID__RELAY__Resgrid__ClientId=Resgrid.Relay
RESGRID__RELAY__Resgrid__ClientSecret=ChangeMeRelaySecret
# Numeric department id (web app: Department > Settings).
RESGRID__RELAY__Resgrid__DepartmentId=
RESGRID__RELAY__Smtp__Port=2525
# Mail to {dispatchcode}@<domain> creates a call. Point the domain's MX here.
RESGRID__RELAY__Smtp__DepartmentAddressDomains__0=dispatch.rg.mylocal
# Mail to {groupcode}@<domain> dispatches a group.
#RESGRID__RELAY__Smtp__GroupAddressDomains__0=groups.rg.mylocal
