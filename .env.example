# -----------------------------------------------
# ---- Example Environment Variables ------------
# -----------------------------------------------
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control!

# -----------------------------------------------
# --- Docker Compose URLs -----------------------
# -----------------------------------------------

NGINX_RESGRID_WEB_URL=rg.mylocal
NGINX_RESGRID_API_URL=rgapi.mylocal
NGINX_RESGRID_EVENTS_URL=rgevents.mylocal

NGINX_RESGRID_WEB_IP=xxx.xxx.xxx.xxx
NGINX_RESGRID_API_IP=xxx.xxx.xxx.xxx
NGINX_RESGRID_EVENTS_IP=xxx.xxx.xxx.xxx

# SSL Certificate Email (use 'internal' for self-signed certs in dev)
NGINX_LETSENCRYPT_EMAIL=internal

# -----------------------------------------------
# --- Database Configuration --------------------
# -----------------------------------------------

POSTGRES_USER=resgridUser
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD_HERE

# Database connection strings
RESGRID__DataConfig__ConnectionString=User ID=resgridUser;Password=CHANGE_ME_SECURE_PASSWORD_HERE;Host=172.16.193.55;Port=5432;Database=resgrid;Pooling=true;Connection Lifetime=0;Include Error Detail=true;
RESGRID__DataConfig__CoreConnectionString=User ID=resgridUser;Password=CHANGE_ME_SECURE_PASSWORD_HERE;Host=172.16.193.55;Port=5432;Database=resgrid;Pooling=true;Connection Lifetime=0;Include Error Detail=true;
RESGRID__DataConfig__DocumentConnectionString=User ID=resgridUser;Password=CHANGE_ME_SECURE_PASSWORD_HERE;Host=172.16.193.55;Port=5432;Database=resgriddoc;Pooling=true;Connection Lifetime=0;Include Error Detail=true;
RESGRID__OidcConfig__ConnectionString=User ID=resgridUser;Password=CHANGE_ME_SECURE_PASSWORD_HERE;Host=172.16.193.55;Port=5432;Database=resgridoidc;Pooling=true;Connection Lifetime=0;Include Error Detail=true;
RESGRID__WorkerConfig__ConnectionString=User ID=resgridUser;Password=CHANGE_ME_SECURE_PASSWORD_HERE;Host=172.16.193.55;Port=5432;Database=resgridworkers;Pooling=true;Connection Lifetime=0;Include Error Detail=true;

# -----------------------------------------------
# --- Redis Cache Configuration -----------------
# -----------------------------------------------

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

RESGRID__CacheConfig__RedisConnectionString=172.16.193.56:6379,Password=CHANGE_ME_REDIS_PASSWORD,allowAdmin=True

# -----------------------------------------------
# --- RabbitMQ Configuration --------------------
# -----------------------------------------------

RABBITMQ_USER=resgrid
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD

RESGRID__ServiceBusConfig__RabbitHostname=172.16.193.57
RESGRID__ServiceBusConfig__RabbitUsername=resgrid
RESGRID__ServiceBusConfig__RabbbitPassword=CHANGE_ME_RABBITMQ_PASSWORD

# -----------------------------------------------
# --- System Configuration ----------------------
# -----------------------------------------------

RESGRID__SystemBehaviorConfig__Environment=3
RESGRID__DataConfig__DatabaseType=1
RESGRID__DataConfig__DocDatabaseType=1
