# -----------------------------------------------
# --- Ambipar Organization Details -------------
# -----------------------------------------------

AMBIPAR__OrganizationName=Ambipar Response Canada Inc.
AMBIPAR__OrganizationCode=AMBIPAR-CA
AMBIPAR__PrimaryLocation=Langley, BC, Canada
AMBIPAR__TimeZone=America/Vancouver
AMBIPAR__DefaultLanguage=en-CA

# -----------------------------------------------
# --- AI Provider Configuration -----------------
# -----------------------------------------------

# AI Provider Selection (OpenAI, Azure, Anthropic)
AMBIPAR__AIProviderType=OpenAI

# OpenAI Configuration
AMBIPAR__OpenAIApiKey=sk-proj-your-openai-api-key-here
AMBIPAR__OpenAIOrganizationId=org-your-organization-id
AMBIPAR__OpenAIModel=gpt-4-turbo
AMBIPAR__OpenAIMaxTokens=2000

# Azure OpenAI Configuration (Alternative)
AMBIPAR__AzureOpenAIEndpoint=https://your-resource.openai.azure.com/
AMBIPAR__AzureOpenAIKey=your-azure-openai-key-here
AMBIPAR__AzureOpenAIDeployment=gpt-4-turbo
AMBIPAR__AzureOpenAIApiVersion=2024-02-15-preview

# Anthropic Claude Configuration (Alternative)
AMBIPAR__AnthropicApiKey=sk-ant-your-anthropic-api-key-here
AMBIPAR__AnthropicModel=claude-3-5-sonnet-20241022
AMBIPAR__AnthropicMaxTokens=4000

# AI Performance Settings
AMBIPAR__AIRequestTimeoutSeconds=30
AMBIPAR__MaxAIRetryAttempts=3
AMBIPAR__CacheAIResponses=true
AMBIPAR__AIResponseCacheDurationMinutes=60

# -----------------------------------------------
# --- SharePoint Integration --------------------
# -----------------------------------------------

AMBIPAR__SharePointSiteUrl=https://ambipar.sharepoint.com/sites/resgrid
AMBIPAR__SharePointClientId=your-sharepoint-client-id
AMBIPAR__SharePointClientSecret=your-sharepoint-client-secret
AMBIPAR__SharePointTenantId=your-tenant-id
AMBIPAR__SharePointDocumentLibrary=Resgrid Documents
AMBIPAR__SharePointEnabled=true

# SharePoint Document Categories
AMBIPAR__SharePointSOPFolder=Standard Operating Procedures
AMBIPAR__SharePointTrainingFolder=Training Materials
AMBIPAR__SharePointComplianceFolder=Compliance Documents
AMBIPAR__SharePointInspectionFolder=Equipment Inspections

# -----------------------------------------------
# --- Microsoft 365 Integration -----------------
# -----------------------------------------------

AMBIPAR__M365TenantId=your-m365-tenant-id
AMBIPAR__M365ClientId=your-m365-client-id
AMBIPAR__M365ClientSecret=your-m365-client-secret
AMBIPAR__M365Enabled=true

# Calendar Integration
AMBIPAR__M365CalendarSyncEnabled=true
AMBIPAR__M365CalendarSyncIntervalMinutes=15

# Teams Integration
AMBIPAR__M365TeamsEnabled=true
AMBIPAR__M365TeamsWebhookUrl=https://outlook.office.com/webhook/your-webhook-url

# -----------------------------------------------
# --- Geotab Fleet Tracking Integration ---------
# -----------------------------------------------

AMBIPAR__GeotabServerUrl=https://my.geotab.com
AMBIPAR__GeotabDatabase=ambipar-ca
AMBIPAR__GeotabUsername=your-geotab-username
AMBIPAR__GeotabPassword=your-geotab-password-here
AMBIPAR__GeotabEnabled=true
AMBIPAR__GeotabSyncIntervalMinutes=5

# Geotab Settings
AMBIPAR__GeotabTrackVehicleLocation=true
AMBIPAR__GeotabTrackFuelLevel=true
AMBIPAR__GeotabTrackMaintenance=true
AMBIPAR__GeotabMaxHistoryDays=90

# -----------------------------------------------
# --- Replicon Timesheet Integration ------------
# -----------------------------------------------

AMBIPAR__RepliconApiUrl=https://na2.replicon.com/ambipar/services
AMBIPAR__RepliconApiToken=your-replicon-api-token-here
AMBIPAR__RepliconCompanyKey=ambipar-company-key
AMBIPAR__RepliconEnabled=true
AMBIPAR__RepliconAutoSync=true

# Replicon Settings
AMBIPAR__RepliconSyncIntervalMinutes=60
AMBIPAR__RepliconBillableHoursThreshold=0.25
AMBIPAR__RepliconDefaultProjectCode=AMBIPAR-DEFAULT

# -----------------------------------------------
# --- Power Apps Integration --------------------
# -----------------------------------------------

AMBIPAR__PowerAppsEnvironmentId=your-powerapp-environment-id
AMBIPAR__PowerAppsApiUrl=https://api.powerapps.com/providers/Microsoft.PowerApps
AMBIPAR__PowerAppsClientId=your-powerapps-client-id
AMBIPAR__PowerAppsClientSecret=your-powerapps-client-secret
AMBIPAR__PowerAppsEnabled=false

# -----------------------------------------------
# --- Operational Categories Configuration ------
# -----------------------------------------------

# Seven Operational Categories
AMBIPAR__OperationalCategories__EnableCustomCategories=true
AMBIPAR__OperationalCategories__RequireCategoryAssignment=true
AMBIPAR__OperationalCategories__AllowMultipleCategories=true

# Category Codes (DO NOT CHANGE)
AMBIPAR__OperationalCategories__Fire=FIRE
AMBIPAR__OperationalCategories__Medical=MEDICAL
AMBIPAR__OperationalCategories__Hazmat=HAZMAT
AMBIPAR__OperationalCategories__Rescue=RESCUE
AMBIPAR__OperationalCategories__Safety=SAFETY
AMBIPAR__OperationalCategories__Support=SUPPORT
AMBIPAR__OperationalCategories__Training=TRAINING

# -----------------------------------------------
# --- Compliance & Certification Settings -------
# -----------------------------------------------

AMBIPAR__Compliance__EnableAutomatedChecks=true
AMBIPAR__Compliance__WarningDays=30
AMBIPAR__Compliance__SendAlerts=true
AMBIPAR__Compliance__AlertEmail=safety@ambipar.ca

# Certification Requirements
AMBIPAR__Compliance__RequireOFA3ForMedical=true
AMBIPAR__Compliance__RequireTDGForHazmat=true
AMBIPAR__Compliance__RequireConfinedSpaceCert=true
AMBIPAR__Compliance__RequireRopeRescueCert=true

# Regulatory Frameworks
AMBIPAR__Compliance__WorkSafeBCCompliance=true
AMBIPAR__Compliance__TransportCanadaTDG=true
AMBIPAR__Compliance__NFPAStandards=true
AMBIPAR__Compliance__CSAStandards=true

# -----------------------------------------------
# --- AI Feature Flags --------------------------
# -----------------------------------------------

# Intelligent Dispatch
AMBIPAR__AI__EnableDispatchRecommendations=true
AMBIPAR__AI__EnablePersonnelSuggestions=true
AMBIPAR__AI__EnableUnitSuggestions=true
AMBIPAR__AI__EnableResponseTimeEstimation=true

# Hazmat Intelligence
AMBIPAR__AI__EnableHazmatAnalysis=true
AMBIPAR__AI__EnablePPERecommendations=true
AMBIPAR__AI__EnableExclusionZones=true
AMBIPAR__AI__EnableTDGCompliance=true

# Equipment Prediction
AMBIPAR__AI__EnableEquipmentPrediction=true
AMBIPAR__AI__EnableMaintenanceScheduling=true
AMBIPAR__AI__EnableInventoryForecasting=true

# Incident Analysis
AMBIPAR__AI__EnableIncidentClassification=true
AMBIPAR__AI__EnableEscalationAnalysis=true
AMBIPAR__AI__EnableSafetyRiskAnalysis=true
AMBIPAR__AI__EnableIncidentSummaries=true
AMBIPAR__AI__EnableTrendAnalysis=true

# Natural Language Queries
AMBIPAR__AI__EnableNaturalLanguageQueries=true
AMBIPAR__AI__EnableQuerySuggestions=true

# Compliance Checking
AMBIPAR__AI__EnableComplianceValidation=true
AMBIPAR__AI__EnableCertificationTracking=true

# Safety Recommendations
AMBIPAR__AI__EnableSafetyProtocols=true
AMBIPAR__AI__EnableEnvironmentalHazards=true
AMBIPAR__AI__EnableRouteOptimization=true

# -----------------------------------------------
# --- Performance & Monitoring ------------------
# -----------------------------------------------

# Performance Targets
AMBIPAR__Performance__DispatchAnalysisMaxSeconds=5
AMBIPAR__Performance__HazmatAnalysisMaxSeconds=5
AMBIPAR__Performance__EquipmentPredictionMaxSeconds=10
AMBIPAR__Performance__NLQueryMaxSeconds=3

# Monitoring
AMBIPAR__Monitoring__EnableMetrics=true
AMBIPAR__Monitoring__EnableHealthChecks=true
AMBIPAR__Monitoring__HealthCheckIntervalSeconds=30

# Logging
AMBIPAR__Logging__LogLevel=Information
AMBIPAR__Logging__EnableStructuredLogging=true
AMBIPAR__Logging__LogToFile=true
AMBIPAR__Logging__LogFilePath=/app/logs
AMBIPAR__Logging__EnableAIAnalysisLogging=true

# -----------------------------------------------
# --- Cost Management ---------------------------
# -----------------------------------------------

AMBIPAR__CostManagement__EnableCostTracking=true
AMBIPAR__CostManagement__DailyBudgetUSD=50.00
AMBIPAR__CostManagement__MonthlyBudgetUSD=1000.00
AMBIPAR__CostManagement__AlertThresholdPercent=80
AMBIPAR__CostManagement__AlertEmail=billing@ambipar.ca

# -----------------------------------------------
# --- Security & Privacy ------------------------
# -----------------------------------------------

AMBIPAR__Security__EnableAuditLogging=true
AMBIPAR__Security__AuditSensitiveOperations=true
AMBIPAR__Security__DataRetentionDays=2555
AMBIPAR__Security__EnablePIIProtection=true
AMBIPAR__Security__EnableEncryptionAtRest=true

# -----------------------------------------------
# --- Mobile App Configuration ------------------
# -----------------------------------------------

AMBIPAR__Mobile__EnableOfflineMode=true
AMBIPAR__Mobile__OfflineCacheDurationHours=72
AMBIPAR__Mobile__EnableGPSTracking=true
AMBIPAR__Mobile__GPSUpdateIntervalSeconds=30
AMBIPAR__Mobile__ForceAppUpdate=false
AMBIPAR__Mobile__MinimumAppVersion=4.0.0

# -----------------------------------------------
# --- Client Management -------------------------
# -----------------------------------------------

AMBIPAR__Clients__EnableClientManagement=true
AMBIPAR__Clients__RequireClientForCalls=false
AMBIPAR__Clients__EnableProjectTracking=true
AMBIPAR__Clients__EnableBillingIntegration=true

# -----------------------------------------------
# --- Offline Operations ------------------------
# -----------------------------------------------

AMBIPAR__Offline__EnableOfflineOperations=true
AMBIPAR__Offline__MaxOfflineDays=7
AMBIPAR__Offline__AutoSyncWhenOnline=true
AMBIPAR__Offline__ConflictResolution=ServerWins

# -----------------------------------------------
# --- Multi-Language Support --------------------
# -----------------------------------------------

AMBIPAR__Localization__EnableMultiLanguage=true
AMBIPAR__Localization__SupportedLanguages=en-CA,fr-CA
AMBIPAR__Localization__DefaultLanguage=en-CA
AMBIPAR__Localization__EnableAutoDetect=true

# -----------------------------------------------
# --- Notification Settings ---------------------
# -----------------------------------------------

AMBIPAR__Notifications__EnableEmailNotifications=true
AMBIPAR__Notifications__EnableSMSNotifications=true
AMBIPAR__Notifications__EnablePushNotifications=true
AMBIPAR__Notifications__EnableTeamsNotifications=true

# Notification Priorities
AMBIPAR__Notifications__CriticalIncident=Email,SMS,Push,Teams
AMBIPAR__Notifications__ComplianceAlert=Email,Teams
AMBIPAR__Notifications__MaintenanceDue=Email
AMBIPAR__Notifications__CertificationExpiring=Email,Push

# -----------------------------------------------
# --- Backup & Disaster Recovery ----------------
# -----------------------------------------------

AMBIPAR__Backup__EnableAutomatedBackups=true
AMBIPAR__Backup__BackupIntervalHours=6
AMBIPAR__Backup__BackupRetentionDays=30
AMBIPAR__Backup__BackupLocation=/backups

# -----------------------------------------------
# --- Development & Debug Settings --------------
# -----------------------------------------------

# Only for development environment!
AMBIPAR__Debug__EnableDebugMode=true
AMBIPAR__Debug__EnableDetailedErrors=true
AMBIPAR__Debug__EnableSwagger=true
AMBIPAR__Debug__EnableTestData=true
AMBIPAR__Debug__MockExternalIntegrations=false

# ===================================================================
# END OF AMBIPAR CONFIGURATION
# ===================================================================
